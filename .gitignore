build/
build-*/
# ...but build-aux/ is source, not output: it holds the flatpak manifests
# (the directory name is GNOME Builder's convention). Without this the
# pattern above swallows new files there silently -- they never show up as
# untracked, so a manifest can be "added" and still be missing from CI.
!build-aux/
compile_commands.json

# Staged from the XRoar sources by cmake/StageXRoar.cmake.
core/xroar-generated/

# XRoar is provided as a pinned release tarball, unpacked here by
# cmake/Dependencies.cmake (it has no git repository to submodule).
third_party/xroar/

# Generated by tools/fujinet/build-fujinet-desktop.sh.
tools/fujinet/work/

# flatpak-builder's state directory.
.flatpak-builder/
build-flatpak*/
repo/
